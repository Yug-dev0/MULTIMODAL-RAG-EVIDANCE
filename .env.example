# Copy to .env and fill in as needed.

# OpenAI
OPENAI_API_KEY=

# Hugging Face
HF_TOKEN=

# LLM provider: "ollama" (fully local, no key needed) or "gemini" (needs a
# valid key from https://aistudio.google.com/apikey — note: Google Cloud/Vertex
# API keys do NOT work here, it must be an AI Studio key starting with "AIzaSy").
LLM_PROVIDER=ollama

# Google Gemini
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Ollama
OLLAMA_VISION_MODEL=qwen2.5vl:7b
OLLAMA_TEXT_MODEL=qwen2.5vl:7b

# PostgreSQL
POSTGRES_URL=postgresql+asyncpg://ragdb:ragdb@localhost:5432/ragdb

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=ragdb_neo4j

# Storage
MEDIA_STORAGE_DIR=./data/media

# Whisper
WHISPER_MODEL_SIZE=small
WHISPER_DEVICE=cpu

# Embeddings
EMBEDDING_DEVICE=mps

# =========================================================================
# Firebase Authentication — BACKEND (Admin SDK / token verification)
# =========================================================================
# "true" runs the backend in mock auth mode (any Bearer token is accepted and
# decoded without signature verification). Set "false" to enforce real
# validation. Defaults to mock automatically when no project id is configured.
FIREBASE_AUTH_MOCK=true

# Required for real token verification.
FIREBASE_PROJECT_ID=

# Optional: absolute path to a service account private key JSON file. If left
# empty but FIREBASE_PROJECT_ID is set, backend/app/api/auth.py verifies ID
# tokens against Google's public x509 certificates instead — no service
# account file required.
FIREBASE_SERVICE_ACCOUNT_JSON=

# --- Firebase FRONTEND (Vite client SDK) ---
# These do NOT go in this file. Vite only loads .env files from its own root,
# and the frontend image is built from ./frontend with no access to the repo
# root, so put them in `frontend/.env` instead:
#
#   VITE_FIREBASE_API_KEY=
#   VITE_FIREBASE_AUTH_DOMAIN=<project>.firebaseapp.com
#   VITE_FIREBASE_PROJECT_ID=
#   VITE_FIREBASE_APP_ID=
#
# Leaving VITE_FIREBASE_API_KEY unset puts the frontend in Mock Auth Mode.
# These are public client identifiers, not secrets — they ship in the browser
# bundle by design.
